{
  "name": "@usemeshly/open-meteo",
  "version": "0.1.0",
  "description": "Typed Open-Meteo client for every API (forecast, historical, air quality, marine, ensemble, climate, flood, seasonal, geocoding, …) on the free and commercial plans, with responses inferred from the requested variables.",
  "keywords": [
    "open-meteo",
    "weather",
    "forecast",
    "air-quality",
    "geocoding",
    "climate",
    "typescript"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usemeshly.git",
    "directory": "packages/open-meteo"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "peerDependencies": {
    "@usemeshly/auth": "workspace:^"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@usemeshly/auth": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "yaml": "2.6.1"
  }
}
