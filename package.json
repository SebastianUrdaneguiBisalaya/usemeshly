{
  "name": "usemeshly",
  "version": "0.0.0",
  "description": "Workspace root of usemeshly: typed, storage-free SDKs for third-party integrations with a shared auth package.",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usemeshly.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7",
    "vitest": "4.1.11"
  }
}
